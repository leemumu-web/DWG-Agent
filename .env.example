# App
APP_NAME=DWG-Agent Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local dev database. Change to mysql+pymysql://dwg_user:password@127.0.0.1:3306/dwg_agent for MySQL.
DATABASE_URL=sqlite:///./var/app.db

# Local storage. Production should replace this with MinIO/NAS implementation.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MAX_UPLOAD_SIZE_MB=512

# JWT
JWT_SECRET_KEY=change-me-in-dev-change-me-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bootstrap super admin
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123456
SUPER_ADMIN_REAL_NAME=系统管理员

# Feature flags
AGENT_ENABLED=false
DXF_PIPELINE_ENABLED=false
CAD_WORKER_ENABLED=false

# Future Redis/Celery/MinIO placeholders
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
