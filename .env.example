# ── App ─────────────────────────────────────────────────────────
APP_NAME=DWG-Agent Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────
# 本机/运行默认 (MySQL): mysql+pymysql://dwg_user:...@127.0.0.1:3306/dwg_agent
# Docker 部署 (MySQL): 使用 .env.docker.example → .env.docker（容器内 host=mysql）
# 单元测试隔离库由 pytest fixture 显式覆盖，不作为运行数据库口径。
# 可选完整 DSN 覆盖（遗留部署兼容）；默认不要设置，避免与 MYSQL_* 漂移：
# DATABASE_URL=mysql+pymysql://dwg_user:CHANGE_ME_MYSQL_PASSWORD@127.0.0.1:3306/dwg_agent

# MySQL 组件字段 (规范 §18；本机运行使用 127.0.0.1，Docker 使用 mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_POOL_SIZE=2
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=3600
MYSQL_DATABASE=dwg_agent
MYSQL_USER=dwg_user
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# ── Storage ─────────────────────────────────────────────────────
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=512

# MinIO（本地开发默认不启用；Docker 值见 .env.docker.example）
MINIO_ENDPOINT=http://localhost:9000
MINIO_METRICS_URL=http://localhost:9000/minio/v2/metrics/cluster
STORAGE_CAPACITY_WARNING_PERCENT=80
STORAGE_CAPACITY_CRITICAL_PERCENT=90
MINIO_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_ORIGINAL=dwg-original
MINIO_BUCKET_DERIVED=dwg-derived
MINIO_BUCKET_REPORTS=dwg-reports
MINIO_BUCKET_TEMP=dwg-temp
MINIO_BUCKET_DXF_ORIGINAL=dxf-original
MINIO_BUCKET_DXF_DERIVED=dxf-derived

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-dev-change-me-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Refresh-cookie Secure flag. 默认跟随 APP_ENV(production→Secure,dev→非 Secure)。
# 仅 HTTP 内网部署(公司 VPN 无公网)时显式设 false。见 .env.docker.example 注释。
# REFRESH_COOKIE_SECURE=

# ── Bootstrap Super Admin ──────────────────────────────────────
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_PASSWORD=SuperAdminPass1
SUPER_ADMIN_REAL_NAME=系统管理员

# ── Feature Flags ──────────────────────────────────────────────
AGENT_ENABLED=false
# 设为 true 启用 DWG→DXF 转换管线（需宿主机 ODA File Converter + xvfb-run）
DXF_PIPELINE_ENABLED=false
DXF2DWG_PIPELINE_ENABLED=false
DXF2EXCEL_PIPELINE_ENABLED=false
DXF_CLASSIFICATION_PIPELINE_ENABLED=false
DXF_CLASSIFICATION_TIMEOUT_SECONDS=1800
DXF_CLASSIFICATION_AUTOSCALE_MIN=1
DXF_CLASSIFICATION_AUTOSCALE_MAX=3
DXF_SPLIT_PIPELINE_ENABLED=false
DXF_SPLIT_TIMEOUT_SECONDS=3600
EXCEL_FINAL_PIPELINE_ENABLED=false
EXCEL_FINAL_TIMEOUT_SECONDS=1800
# 五金手册库默认复用 MYSQL_HOST/PORT/USER/PASSWORD，仅数据库名不同。
# 需要独立只读账号时再取消注释覆盖：
# HANDBOOK_MYSQL_HOST=127.0.0.1
# HANDBOOK_MYSQL_PORT=3306
# HANDBOOK_MYSQL_DATABASE=hardware_handbook
# HANDBOOK_MYSQL_USER=dwg_handbook_reader
# HANDBOOK_MYSQL_PASSWORD=CHANGE_ME_HANDBOOK_PASSWORD
CELERY_STALE_JOB_TIMEOUT_SECONDS=7200
BUSINESS_TIMEZONE=Asia/Shanghai
DAILY_ARCHIVE_PREVIEW_TTL_MINUTES=10
DAILY_ARCHIVE_MAX_FILES=5000
DAILY_ARCHIVE_MAX_SOURCE_GB=50
WORKFLOW_BATCH_EXPORT_TTL_MINUTES=60
CAD_WORKER_ENABLED=false
REMNANT_INVENTORY_ENABLED=false
REMNANT_IMPORT_MAX_FILES=100
REMNANT_CONVERT_WORKER_CONCURRENCY=2
REMNANT_PARSE_WORKER_CONCURRENCY=4
REMNANT_PARSE_TIMEOUT_SECONDS=120

# ── Celery (MySQL SQLAlchemy transport) ─────────────────────────
# broker / result backend 由 config.py 从应用的有效 MySQL DSN 自动派生。
CELERY_TASK_ALWAYS_EAGER=false
DXF_WORKER_CONCURRENCY=8
DXF2DWG_WORKER_CONCURRENCY=8
DXF_WORKER_DISPLAY=:91
DXF2DWG_WORKER_DISPLAY=:92
ODA_CONVERTER_RETRIES=3
DXF2DWG_CONVERTER_RETRIES=3
CAD_BATCH_MAX_SHARDS=4
CAD_BATCH_MIN_FILES_PER_SHARD=8

# ── Agent Memory (MySQL-backed) ─────────────────────────────────
AGENT_MEMORY_TTL=7200
AGENT_MAX_MESSAGES=20

# ── LLM — spec §18.1 (Stage 2: Agent subsystem) ─────────────────
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com

# ── MCP — spec §18.1 (Stage 2: MCP client) ──────────────────────
MCP_CAD_COMMAND=uvx
MCP_CAD_ARGS=cad-mcp-server,stdio

# ── CAD Worker — spec §18.1 (Stage 4: Windows CAD node) ─────────
CAD_WORKER_API_BASE=http://cad-worker.internal:8080
CAD_WORKER_API_KEY=

# ── Container deployment overrides (unused by local scripts) ────
DWG_AGENT_IMAGE=dwg-agent-backend:local
DWG_AGENT_FRONTEND_IMAGE=dwg-agent-frontend:local
NODE_IMAGE=node:22-alpine
HTTP_PORT=80

# ── Frontend ────────────────────────────────────────────────────
# Nginx 反代模式（推荐）: 留空 → 相对路径 → Nginx → 后端
# 直连模式: http://127.0.0.1:8010
VITE_API_BASE_URL=
