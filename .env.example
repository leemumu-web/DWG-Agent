# ── App ─────────────────────────────────────────────────────────
APP_NAME=DWG-Agent Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────
# 本地开发 (SQLite):  sqlite:///./var/app.db
# Docker 部署 (MySQL): mysql+pymysql://dwg_user:${MYSQL_PASSWORD}@mysql:3306/dwg_agent
DATABASE_URL=sqlite:///./var/app.db

# MySQL（Docker Compose 时设置）
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# ── Storage ─────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MAX_UPLOAD_SIZE_MB=512

# MinIO（Docker Compose 时设置）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-dev-change-me-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Bootstrap Super Admin ──────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123456
SUPER_ADMIN_REAL_NAME=系统管理员

# ── Feature Flags ──────────────────────────────────────────────
AGENT_ENABLED=false
DXF_PIPELINE_ENABLED=false
CAD_WORKER_ENABLED=false

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis-password
REDIS_MEMORY_TTL=7200
REDIS_MAX_MESSAGES=20
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Frontend ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
