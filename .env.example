# ── App ─────────────────────────────────────────────────────────
APP_NAME=DWG-Agent Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────
# 本地开发 (SQLite):  sqlite:///./var/app.db
# Docker 部署 (MySQL): 使用 .env.docker.example → .env.docker
DATABASE_URL=sqlite:///./var/app.db

# MySQL 组件字段 (规范 §18；本地手动切 MySQL 时可用)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=dwg_agent
MYSQL_USER=dwg_user
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# ── Storage ─────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MAX_UPLOAD_SIZE_MB=512

# MinIO（本地开发默认不启用；Docker 值见 .env.docker.example）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-dev-change-me-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Bootstrap Super Admin ──────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123456
SUPER_ADMIN_REAL_NAME=系统管理员

# ── Feature Flags ──────────────────────────────────────────────
AGENT_ENABLED=false
DXF_PIPELINE_ENABLED=false
CAD_WORKER_ENABLED=false

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MEMORY_TTL=7200
REDIS_MAX_MESSAGES=20
# 本地开发（无密码）: redis://localhost:6379/0
# Docker（有密码）:  使用 .env.docker.example 中的 redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
#
# 注意：celery_broker_url / celery_result_backend 在 config.py 中已是计算属性，
# 自动跟随 REDIS_PASSWORD。以下两行保留供 Celery 库直接读取 os.environ 使用。
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Frontend ────────────────────────────────────────────────────
# Nginx 反代模式（推荐）: 留空 → 相对路径 → Nginx → 后端
# 直连模式: http://127.0.0.1:8000
VITE_API_BASE_URL=
