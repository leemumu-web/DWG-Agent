# VITE_API_BASE_URL — 决定前端 API 请求走相对路径还是绝对 URL。
#
# 本地开发 (npm run dev):
#   http://127.0.0.1:8010  — 直连后端开发服务器 (Vite proxy 也会转发 /api)
#
# Docker / 生产 (npm run build + Nginx 反代):
#   留空 — API 走相对路径 /api/... → Nginx → backend-api:8010
#   生产构建时由 .env.production 强制留空,避免绝对 URL 烘焙进 bundle
#   (否则会绕过 Nginx 限流/安全头,且被 CSP connect-src 'self' 拦截)。
VITE_API_BASE_URL=
