# ────────────────────────────────────────────────────────────────
# DWG-Agent Platform — Docker Compose 环境变量模板
# 使用方式:
#   cp .env.docker.example .env.docker
#   修改所有 CHANGE_ME_* 值
#   docker compose up -d
#
# 注意:
#   - .env.docker 为本机真实密钥文件，已被 .gitignore 忽略
#   - 本文件只提交占位值，不提交真实生产密钥
#   - URL 字段使用完整字面值，避免 Compose 从 shell 或根 .env 二次插值
#   - 请使用 scripts/docker.sh 管理容器；脚本会固定项目名并复用正式数据卷
# ────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────
APP_NAME=DWG-Agent Platform
APP_ENV=production
TZ=Asia/Shanghai
DOCKER_MIN_FREE_GIB=20
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost

# ── Database (MySQL) ────────────────────────────────────────────
# 可选完整 DSN 覆盖；默认由下列 MYSQL_* 字段构造，避免重复配置：
# DATABASE_URL=mysql+pymysql://dwg_user:CHANGE_ME_MYSQL_PASSWORD@mysql:3306/dwg_agent
MYSQL_HOST=mysql
MYSQL_PORT=3306
DB_POOL_SIZE=2
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=3600
MYSQL_DATABASE=dwg_agent
MYSQL_USER=dwg_user
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
# 小型主机的安全默认值；生产服务器按实机内存与并发覆盖。
MYSQL_INNODB_BUFFER_POOL_SIZE=2G
MYSQL_MAX_CONNECTIONS=200
MYSQL_TABLE_OPEN_CACHE=2000
MYSQL_THREAD_CACHE_SIZE=50

# ── Storage (MinIO) ─────────────────────────────────────────────
STORAGE_BACKEND=minio
MAX_UPLOAD_SIZE_MB=512
MAX_ZIP_ENTRY_COUNT=5000
MINIO_ENDPOINT=http://minio:9000
MINIO_METRICS_URL=http://minio:9000/minio/v2/metrics/cluster
STORAGE_CAPACITY_WARNING_PERCENT=80
STORAGE_CAPACITY_CRITICAL_PERCENT=90
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET_ORIGINAL=dwg-original
MINIO_BUCKET_DERIVED=dwg-derived
MINIO_BUCKET_REPORTS=dwg-reports
MINIO_BUCKET_TEMP=dwg-temp
MINIO_BUCKET_DXF_ORIGINAL=dxf-original
MINIO_BUCKET_DXF_DERIVED=dxf-derived

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_256_BIT_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Refresh-cookie Secure flag. 默认跟随 APP_ENV (production→Secure)。
# 若 Nginx 未上 TLS(仅 HTTP,如公司 VPN 内网无公网暴露),浏览器会丢弃
# Secure Cookie → 刷新流程静默失效(登录 30min 后被踢回登录页)。
# 此场景显式设 false 让 Cookie 在 HTTP 下生效。
# 警告:公网或明文链路不可设 false,14 天 refresh_token 不能明文传输。
# REFRESH_COOKIE_SECURE=false

# ── Bootstrap Super Admin ──────────────────────────────────────
SUPER_ADMIN_USERNAME=super_admin
# 生产环境启动门禁：至少 16 位，含大写、小写、数字和特殊字符，且不得含用户名。
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_REAL_NAME=系统管理员

# 可选：升级保留数据库后，超管密码可能已由用户修改。为发布后的存储闭环验收
# 单独指定一个现有管理员；两项必须同时配置，且不会重置或修改该账号。
# VERIFY_ADMIN_USERNAME=release_verifier
# VERIFY_ADMIN_PASSWORD=CHANGE_ME_VERIFY_ADMIN_PASSWORD

# ── Feature Flags ──────────────────────────────────────────────
AGENT_ENABLED=false
# 服务器生产流程已验收：DWG→DXF、分类、拆板和 Excel 第一阶段默认启用。
# DXF→DWG 作为独立转换工具启用，但不进入主生产流程；DXF→Excel 继续关闭。
DXF_PIPELINE_ENABLED=true
DXF2DWG_PIPELINE_ENABLED=true
DXF2EXCEL_PIPELINE_ENABLED=false
DXF_CLASSIFICATION_PIPELINE_ENABLED=true
DXF_CLASSIFICATION_TIMEOUT_SECONDS=1800
# 分类器输入和 staging 使用 app_var，避免 768 MiB /tmp tmpfs 被大批次耗尽。
DXF_CLASSIFICATION_WORK_ROOT=/app/var/dxf-classification-work
DXF_SPLIT_PIPELINE_ENABLED=true
DXF_SPLIT_TIMEOUT_SECONDS=3600
# 大体积拆板中间文件必须使用 app_var，不能占用 768 MiB 的 /tmp tmpfs。
DXF_SPLIT_WORK_ROOT=/app/var/dxf-split-work
EXCEL_FINAL_PIPELINE_ENABLED=true
EXCEL_FINAL_TIMEOUT_SECONDS=1800
EXCEL_STAGE2_TIMEOUT_SECONDS=7200
# 第二阶段逐张读取最多 5000 张 BH 图纸，工作目录必须落在 app_var。
EXCEL_STAGE2_WORK_ROOT=/app/var/excel-stage2-work
# hardware_handbook 默认使用上面的 mysql 服务与 dwg_user 只读授权。
# 如使用外部手册库，可通过 HANDBOOK_MYSQL_HOST/PORT/DATABASE/USER/PASSWORD 覆盖。
CELERY_STALE_JOB_TIMEOUT_SECONDS=7200
BUSINESS_TIMEZONE=Asia/Shanghai
DAILY_ARCHIVE_PREVIEW_TTL_MINUTES=10
DAILY_ARCHIVE_MAX_FILES=5000
DAILY_ARCHIVE_MAX_SOURCE_GB=50
WORKFLOW_BATCH_EXPORT_TTL_MINUTES=60
CAD_WORKER_ENABLED=false
REMNANT_INVENTORY_ENABLED=true
REMNANT_IMPORT_MAX_FILES=100
REMNANT_PARSE_TIMEOUT_SECONDS=120

# ── Celery (MySQL SQLAlchemy transport) ─────────────────────────
# broker / result backend 由 config.py 从应用的有效 MySQL DSN 自动派生。
# 各队列使用固定进程池和 prefetch=1；CPU 密集型阶段由下方 CPU 上限和并发数共同限流。
# 不在运行中动态缩放 prefork，避免缩容后再次扩容造成进程池锁死。
CELERY_TASK_ALWAYS_EAGER=false
WEB_CONCURRENCY=4
REPORT_WORKER_CONCURRENCY=1
DXF_WORKER_CONCURRENCY=4
DXF2DWG_WORKER_CONCURRENCY=2
DXF_CLASSIFICATION_WORKER_CONCURRENCY=2
DXF_SPLIT_WORKER_CONCURRENCY=1
REMNANT_CONVERT_WORKER_CONCURRENCY=1
REMNANT_PARSE_WORKER_CONCURRENCY=2
EXCEL_FINAL_WORKER_CONCURRENCY=1
EXCEL_STAGE2_WORKER_CONCURRENCY=1
DXF_WORKER_DISPLAY=:91
DXF2DWG_WORKER_DISPLAY=:92
# 不含首次执行；默认总共最多尝试 4 次，允许范围 0–5。
ODA_CONVERTER_RETRIES=3
DXF2DWG_CONVERTER_RETRIES=3
CAD_BATCH_MAX_SHARDS=4
CAD_BATCH_MIN_FILES_PER_SHARD=8

# 生产基准为 24 vCPU / 64 GiB：CPU 是主要调度边界，内存仅设置宽松安全上限。
# 该配置也已在 24 vCPU / 30 GiB 本机完成双项目并发实测；更小主机只允许下调。
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=4g
APP_PIDS_LIMIT=256
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT=6g
DISPATCHER_CPU_LIMIT=0.5
DISPATCHER_MEMORY_LIMIT=512m
DISPATCHER_PIDS_LIMIT=64
REPORT_WORKER_CPU_LIMIT=1.0
REPORT_WORKER_MEMORY_LIMIT=1g
DXF_WORKER_CPU_LIMIT=6.0
DXF_WORKER_MEMORY_LIMIT=8g
DXF2DWG_WORKER_CPU_LIMIT=3.0
DXF2DWG_WORKER_MEMORY_LIMIT=6g
DXF2EXCEL_WORKER_CPU_LIMIT=2.0
DXF2EXCEL_WORKER_MEMORY_LIMIT=3g
DXF_CLASSIFICATION_WORKER_CPU_LIMIT=2.0
DXF_CLASSIFICATION_WORKER_MEMORY_LIMIT=4g
DXF_SPLIT_WORKER_CPU_LIMIT=2.0
DXF_SPLIT_WORKER_MEMORY_LIMIT=4g
EXCEL_FINAL_WORKER_CPU_LIMIT=2.0
EXCEL_FINAL_WORKER_MEMORY_LIMIT=4g
EXCEL_STAGE2_WORKER_CPU_LIMIT=2.0
EXCEL_STAGE2_WORKER_MEMORY_LIMIT=8g
REMNANT_CONVERT_WORKER_CPU_LIMIT=1.5
REMNANT_CONVERT_WORKER_MEMORY_LIMIT=2g
REMNANT_PARSE_WORKER_CPU_LIMIT=2.0
REMNANT_PARSE_WORKER_MEMORY_LIMIT=2g
MAINTENANCE_WORKER_CPU_LIMIT=1.0
MAINTENANCE_WORKER_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=4.0
MYSQL_MEMORY_LIMIT=8g
MINIO_CPU_LIMIT=2.0
MINIO_MEMORY_LIMIT=4g
NGINX_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=512m

# ── Agent Memory (MySQL-backed) ─────────────────────────────────
AGENT_MEMORY_TTL=7200
AGENT_MAX_MESSAGES=20

# ── LLM — spec §18.1 (Stage 2: Agent subsystem) ─────────────────
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com

# ── MCP — spec §18.1 (Stage 2: MCP client) ──────────────────────
MCP_CAD_COMMAND=uvx
MCP_CAD_ARGS=cad-mcp-server,stdio

# ── CAD Worker — spec §18.1 (Stage 4: Windows CAD node) ─────────
CAD_WORKER_API_BASE=http://cad-worker.internal:8080
CAD_WORKER_API_KEY=

# ── Container images / public port ──────────────────────────────
# CI/CD 可把下面两个值改为仓库中的不可变 tag 或 digest；本地默认由 Compose 构建。
DWG_AGENT_IMAGE=dwg-agent-backend:local
DWG_AGENT_FRONTEND_IMAGE=dwg-agent-frontend:local
# Docker Hub 不可达时可改为满足 Vite 要求（Node >=22.12）的企业/Quay 镜像。
NODE_IMAGE=node:22-alpine
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# ── Frontend build-time config ──────────────────────────────────
# 留空表示浏览器走 Nginx same-origin /api；修改后必须重建 frontend 镜像。
VITE_API_BASE_URL=
