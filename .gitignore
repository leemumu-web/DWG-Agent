# ============================================================
# DWG-Agent .gitignore
# Principle: track everything by default; ignore only secrets,
# build artifacts, dependencies, caches, and runtime data.
# ============================================================

# --- Secrets (never commit) ---
.env
.env.docker
.env.production
.env.*.local
*.pem
*.key

# --- Dependencies ---
node_modules/
.venv/
venv/

# --- Build artifacts ---
dist/
build/
*.pyc
*.pyo
*.egg-info/
*.egg
tsconfig.tsbuildinfo

# --- Test artifacts / browser traces ---
test-results/
playwright-report/
.nyc_output/
.playwright-cli/
.superpowers/

# --- Caches ---
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vite/
.uv_cache/
.mplconfig/

# --- Runtime data (filesystem-based storage, logs, dbs) ---
var/
backend/var/
/backups/
*.db
*.sqlite
*.db-journal
*.sqlite-journal
infra/gateway/nginx/logs/
logs/

# --- IDE / Editor ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# --- OS temp files ---
*.swp
*.swo
*.swn
*.bak

# --- Binary archives (use git-lfs or external storage) ---
*.zip
*.tar.gz
*.tar.gz.gpg
*.tar.gz.gpg.sha256
*.tar.gz.gpg.asc
/dwg-agent-*-deploy.sh
*.7z
# release packages + deploy artifacts (external storage / remote host)
/releases/

# --- Local working data (test files, docs, CAD samples — never commit) ---
Data/
# 本轮 BH/BOX 比例与翼缘规则验收输入（85 张 DXF，约 300 MB）
/准备优化的目标图纸/
# CAD samples & pipeline intermediates in excel_final
/Stages/excel_final/data/
# Ad-hoc analysis bundles (zips, unpacked samples, repro scripts)
/tmp_data/
# 太子：拆分/备份/中间结果等本地工作数据（zip、manifest、前后对比）
/太子/
# BH_optimization 工作区：仅跟踪源码/文档/配置，样本 DXF 与拆板结果属大数据
/BH_optimization/sample_input/
/BH_optimization/sample_output/
/BH_optimization/single_input/
/BH_optimization/single_output/

# --- Test runner output (playwright, etc.) ---
/output/

# --- Package-manager artifacts in wrong directories ---
/backend/package-lock.json

# --- Vendored kkFileView: track source, exclude the ~832M portable
#     LibreOffice bundle (fetched at deploy time, not source) ---
third_parts/kkFileView/server/LibreOfficePortable/

# --- BH/BOX split before/after merged review sheets (large delivery artifacts) ---
/BH拆板合图/
/BOX拆板前分类/
# BH/BOX 拆板前 DXF 交付件（352 张 BH + 大量 BOX Tekla 单件图，数百 MB）
/BH_拆板前_dxf汇总/
/BOX_拆板前_dxf汇总/
