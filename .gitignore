# ============================================================
# DWG-Agent .gitignore
# Principle: track everything by default; ignore only secrets,
# build artifacts, dependencies, caches, and runtime data.
# ============================================================

# --- Secrets (never commit) ---
.env
.env.docker
.env.production
.env.*.local
*.pem
*.key

# --- Dependencies ---
node_modules/
.venv/
venv/

# --- Build artifacts ---
dist/
build/
*.pyc
*.pyo
*.egg-info/
*.egg
tsconfig.tsbuildinfo

# --- Test artifacts ---
test-results/
playwright-report/
.nyc_output/

# --- Caches ---
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vite/

# --- Runtime data (filesystem-based storage, logs, dbs) ---
var/
backend/var/
*.db
*.sqlite
*.db-journal
*.sqlite-journal
infra/nginx/logs/
logs/

# --- IDE / Editor ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# --- OS temp files ---
*.swp
*.swo
*.swn
*.bak

# --- Binary archives (use git-lfs or external storage) ---
*.zip
*.tar.gz
*.7z
