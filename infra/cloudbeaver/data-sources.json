{
  "folders": {},
  "connections": {
    "mysql8-dwg-admin": {
      "provider": "mysql",
      "driver": "mysql8",
      "name": "DWG Agent - Admin",
      "configuration": {
        "host": "mysql",
        "port": "3306",
        "database": "dwg_agent",
        "url": "jdbc:mysql://mysql:3306/dwg_agent",
        "configurationType": "MANUAL",
        "type": "prod",
        "closeIdleConnection": true,
        "auth-model": "native",
        "auth-properties": {
          "name": "dwg_console_admin",
          "password": "${DBA_MYSQL_ADMIN_PASSWORD}"
        },
        "bootstrap": {
          "autocommit": true
        }
      }
    },
    "mysql8-dwg-reader": {
      "provider": "mysql",
      "driver": "mysql8",
      "name": "DWG Agent - Read only",
      "configuration": {
        "host": "mysql",
        "port": "3306",
        "database": "dwg_agent",
        "url": "jdbc:mysql://mysql:3306/dwg_agent",
        "configurationType": "MANUAL",
        "type": "prod",
        "closeIdleConnection": true,
        "auth-model": "native",
        "auth-properties": {
          "name": "dwg_console_reader",
          "password": "${DBA_MYSQL_READER_PASSWORD}"
        },
        "bootstrap": {
          "autocommit": true
        }
      }
    }
  }
}
